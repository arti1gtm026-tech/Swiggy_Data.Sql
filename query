--Category-wise Order and Average Rating Analysis
SELECT 
C.CATEGORY,
COUNT(*) TOTAL_ORDER,
AVG(F.RATING)AS ORDER_RATING
FROM SWIGGY_ORDERS F
JOIN CATEGORY_TABLE C
ON F.CATEGORY_ID=C.CATEGORY_ID
GROUP BY C.CATEGORY
ORDER BY COUNT(*) DESC;


---PRICE RANGE ORDER

SELECT 
CASE 
WHEN  CONVERT (FLOAT,PRICE_INR)<100 THEN 'Under 100'
WHEN CONVERT(FLOAT,PRICE_INR)BETWEEN 100 AND 199 THEN '100-199'
WHEN CONVERT(FLOAT,PRICE_INR)BETWEEN 200 AND 299 THEN '200-299'
WHEN CONVERT (FLOAT,PRICE_INR) BETWEEN 300 AND 399 THEN '300-399'
WHEN CONVERT(FLOAT,PRICE_INR)BETWEEN 400 AND 499 THEN '400-499'
ELSE '500+'
END AS PRICE_RANGE,
COUNT(*) AS TOTAL_ORDERS
FROM SWIGGY_ORDERS 
GROUP BY
CASE
WHEN  CONVERT (FLOAT,PRICE_INR)<100 THEN 'Under 100'
WHEN CONVERT(FLOAT,PRICE_INR)BETWEEN 100 AND 199 THEN '100-199'
WHEN CONVERT(FLOAT,PRICE_INR)BETWEEN 200 AND 299 THEN '200-299'
WHEN CONVERT (FLOAT,PRICE_INR) BETWEEN 300 AND 399 THEN '300-399'
WHEN CONVERT(FLOAT,PRICE_INR)BETWEEN 400 AND 499 THEN '400-499'
ELSE '500+'
END
ORDER BY TOTAL_ORDERS DESC; 







  
