--- Swiggy orders

INSERT INTO Swiggy_orders
(
    date_id,
    Price_INR,
    Rating,
    Rating_count,
    location_id,
    restaurant_id,
    category_id,
    dish_id
)
SELECT
    dd.date_id,
    s.Price_INR,
    s.Rating,
    s.Rating_count,
    dl.location_id,
    dr.restaurant_id,
    dc.category_id,
    dsh.dish_id
FROM Swiggy_Data s

JOIN Date_table dd
    ON dd.Full_Date = s.Order_Date

JOIN location_table dl
    ON dl.State = s.State
    AND dl.City = s.City
    AND dl.location = s.location

JOIN restaurant_table dr
    ON dr.restaurant_name = s.restaurant_name

JOIN Category_table dc
    ON dc.category = s.category

JOIN Dish_table dsh
    ON dsh.Dish_name = s.Dish_Name



