   SELECT FORMAT (AVG (CONVERT(FLOAT, Price_INR )),'N2')+ 'INR' AS avg_dish_price
   FROM Swiggy_orders


   -- Date based analysis
   --- Monthly order analysis

   SELECT
   d.Year,
   d.MONTH,
   d.Month_name,
   COUNT(*) AS total_orders
   FROM Swiggy_orders f
   JOIN date_table d
   ON f.date_id= d.date_id
   GROUP BY 
   d.Year,
   d.Month,
   d.Month_Name
   ORDER BY COUNT(*) DESC

   -- monthly order sales
   SELECT
   d.Year,
   d.Month, 
   d.Month_name,
   FORMAT (SUM( CONVERT( FLOAT, Price_INR))/1000000, 'N2')+'M' AS total_revenue
   FROM Swiggy_orders f
   JOIN date_table d
   ON f.date_id= d.date_id
   GROUP BY 
     d.Year, d.Month,d.Month_Name
   ORDER BY SUM(Price_INR) DESC


   -- Quarterly order analysis
    SELECT
   d.Year,
   d.quarter,
   COUNT(*) AS total_orders
   FROM Swiggy_orders f
   JOIN date_table d
   ON f.date_id= d.date_id
   GROUP BY 
   d.Year,
   d.quarter
   ORDER BY COUNT(*) DESC

   --yearly order analysis
    SELECT
   d.Year,
   COUNT(*) AS total_orders
   FROM Swiggy_orders f
   JOIN date_table d
   ON f.date_id= d.date_id
   GROUP BY 
   d.Year
   ORDER BY COUNT(*) DESC


-- week days analysis
SELECT
DATENAME(WEEKDAY, d.full_date) AS Day_name,
COUNT(*) AS Total_orders
FROM Swiggy_orders f
JOIN date_table d
ON f.date_id = d.date_id
GROUP BY DATENAME(WEEKDAY, d.Full_date),DATEPART(WEEKDAY, d.Full_date)
