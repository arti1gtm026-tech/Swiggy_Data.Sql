    -- total orders

    SELECT COUNT(*) AS total_orders
    FROM Swiggy_orders


   -- total revenue
   SELECT FORMAT(SUM (CONVERT(FLOAT, Price_INR ))/1000000,'N2')+ ' M MILLION'
   AS total_revenue
   FROM Swiggy_orders

